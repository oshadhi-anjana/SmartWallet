{
  "expo": {
    "name": "SmartWallet",
    "slug": "SmartWallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smartwallet-logo.png",
    "scheme": "smartwallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/smartwallet-logo.png",
      "bundleIdentifier": "com.oshadhi.smartwallet"
    },
    "android": {
      "package": "com.oshadhi.smartwallet",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/smartwallet-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/smartwallet-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartWallet to photograph receipts for your expense records."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F9D58",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SmartWallet to use Face ID to protect your financial information."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe465b80-d9ea-4185-ab4e-1ad4ccddc99c"
      }
    }
  }
}
